module

public import BrickAccessibility.Quiver.Strings

/-!
# Special biserial, string and gentle data (Definitions 3.2 and 3.3)

All conditions are stated for left modules over `A`; for `Λ = kQ/I` and
`A = Λᵐᵒᵖ`, the path `ab` (first `a`, then `b`) is nonzero in `Λ` exactly when
`pval (src a) [a, b] ≠ 0`.

* `PathData.IsSpecialBiserial`: at most two arrows start and at most two end at
  each vertex; each arrow has at most one allowed successor and one allowed
  predecessor.
* `PathData.IsAdmissible`: vertices and arrows are nonzero and long paths vanish.
* `MonomialData.IsStringAlgebra`: admissible special biserial monomial data
  (Definition 3.3: `I` generated by paths).
* `MonomialData.IsGentle`: a string algebra whose zero paths are generated in
  length two and in which each arrow has at most one forbidden successor and one
  forbidden predecessor.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace BrickAccessibility

open BrickAccessibility.Statement

variable {Q : FinQuiver} {A : Type*} [Ring A]

namespace PathData

variable (D : PathData Q A)

/-- `b` is an allowed successor of `a`: the path `ab` is nonzero. -/
def Allowed (a b : Q.A) : Prop := Q.src b = Q.tgt a ∧ D.pval (Q.src a) [a, b] ≠ 0

/-- `b` is a forbidden successor of `a`: `ab` is a composable zero path. -/
def Forbidden (a b : Q.A) : Prop := Q.src b = Q.tgt a ∧ D.pval (Q.src a) [a, b] = 0

/-- Definition 3.2 (combinatorial part). -/
def IsSpecialBiserial : Prop :=
  (∀ x, Nat.card {a : Q.A // Q.src a = x} ≤ 2) ∧
  (∀ y, Nat.card {a : Q.A // Q.tgt a = y} ≤ 2) ∧
  (∀ a, Nat.card {b : Q.A // D.Allowed a b} ≤ 1) ∧
  (∀ b, Nat.card {a : Q.A // D.Allowed a b} ≤ 1)

/-- Admissibility: nonzero vertices and arrows, and vanishing of long paths. -/
def IsAdmissible : Prop :=
  (∀ v, D.e v ≠ 0) ∧ (∀ a, D.α a ≠ 0) ∧ ∃ N : ℕ, ∀ x (l : List Q.A), N ≤ l.length → D.pval x l = 0

end PathData

namespace MonomialData

variable {k : Type*} [Field k] [Algebra k A] (D : MonomialData k A)

/-- Definition 3.3: a string algebra. -/
def IsStringAlgebra : Prop := D.toPathData.IsAdmissible ∧ D.toPathData.IsSpecialBiserial

/-- The zero paths are generated by paths of length two: a composable path of
positive length is zero exactly when some consecutive pair of its arrows is a
zero path. -/
def IsQuadratic : Prop :=
  ∀ (a : D.Q.A) (l : List D.Q.A), D.Q.IsWalk (D.Q.src a) ((a :: l).map (·, true)) →
    (D.pval (D.Q.src a) (a :: l) = 0 ↔
      ∃ (i : ℕ) (hi : i + 1 < (a :: l).length),
        D.toPathData.Forbidden ((a :: l)[i]'(by omega)) ((a :: l)[i + 1]'hi))

/-- Definition 3.3: a gentle algebra. -/
def IsGentle : Prop :=
  D.IsStringAlgebra ∧ D.IsQuadratic ∧
  (∀ a, Nat.card {b : D.Q.A // D.toPathData.Forbidden a b} ≤ 1) ∧
  (∀ b, Nat.card {a : D.Q.A // D.toPathData.Forbidden a b} ≤ 1)

end MonomialData

end BrickAccessibility
