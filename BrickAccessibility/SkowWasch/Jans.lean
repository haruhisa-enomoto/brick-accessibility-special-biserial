module

public import BrickAccessibility.SkowWasch.Local
public import BrickAccessibility.Basic.Finiteness

/-!
# Jans: representation-finite algebras have chains of corner ideals

For `z, z' ∈ e_iAe_j` in a representation-finite algebra over an infinite field, one lies in
the two-sided ideal generated by the other (`mem_Id_or_mem_Id`). Otherwise the cyclic
modules `V_c` generated by `t = (ē_j, ē_j)` in `A/I₁ × A/I₂`, with `z' t = c z t`, are
indecomposable and pairwise non-isomorphic (Jans, *Ann. of Math.* 66 (1957), Thm 2.1).
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace BrickAccessibility

namespace SkowWasch

namespace BasicData

universe u

variable {k : Type*} [Field k] {A : Type u} [Ring A] [Algebra k A] (B : BasicData k A)

/-- The two-sided ideal generated by `z`. -/
def Id (z : A) : Submodule k A := Submodule.span k {x | ∃ a b : A, x = a * z * b}

theorem mem_Id_self (z : A) : z ∈ Id (k := k) z :=
  Submodule.subset_span ⟨1, 1, by simp⟩

theorem Id_mul_left (z a : A) {x : A} (hx : x ∈ Id (k := k) z) : a * x ∈ Id (k := k) z := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨b, c, rfl⟩ := hx
      exact Submodule.subset_span ⟨a * b, c, by simp [mul_assoc]⟩
  | zero => rw [mul_zero]; exact Submodule.zero_mem _
  | add x y _ _ h h' => rw [mul_add]; exact Submodule.add_mem _ h h'
  | smul μ x _ h => rw [mul_smul_comm]; exact Submodule.smul_mem _ μ h

theorem Id_mul_right (z a : A) {x : A} (hx : x ∈ Id (k := k) z) : x * a ∈ Id (k := k) z := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨b, c, rfl⟩ := hx
      exact Submodule.subset_span ⟨b, c * a, by simp [mul_assoc]⟩
  | zero => rw [zero_mul]; exact Submodule.zero_mem _
  | add x y _ _ h h' => rw [add_mul]; exact Submodule.add_mem _ h h'
  | smul μ x _ h => rw [smul_mul_assoc]; exact Submodule.smul_mem _ μ h

theorem Id_le_R {z : A} (hz : z ∈ B.R) : Id (k := k) z ≤ B.R := by
  rw [Id, Submodule.span_le]
  rintro _ ⟨a, b, rfl⟩
  exact B.mul_mem_right _ _ (B.mul_mem_left _ _ hz)

theorem e_mul_of_corner {i j : Fin B.n} {z : A} (hz : B.e i * z * B.e j = z) (v : Fin B.n) :
    B.e v * z = if v = i then z else 0 := by
  rw [← hz, ← mul_assoc, ← mul_assoc, B.e_mul_e]
  split_ifs with h
  · subst h; rfl
  · rw [zero_mul, zero_mul]

theorem mul_e_of_corner {i j : Fin B.n} {z : A} (hz : B.e i * z * B.e j = z) (v : Fin B.n) :
    z * B.e v = if j = v then z else 0 := by
  rw [← hz, mul_assoc, B.e_mul_e]
  split_ifs with h
  · subst h; rfl
  · rw [mul_zero]

/-- Left multiplication on a corner element is a scalar plus a radical factor. -/
theorem mul_corner {i j : Fin B.n} {z : A} (hz : B.e i * z * B.e j = z) (a : A) :
    ∃ (c : k) (r : A), r ∈ B.R ∧ a * z = c • z + r * z := by
  obtain ⟨c, hc⟩ := B.decomp a
  refine ⟨c i, a - ∑ v, c v • B.e v, hc, ?_⟩
  rw [sub_mul, Finset.sum_mul]
  have : ∑ v, c v • B.e v * z = c i • z := by
    rw [Finset.sum_eq_single i]
    · rw [smul_mul_assoc, B.e_mul_of_corner hz, if_pos rfl]
    · intro v _ hv; rw [smul_mul_assoc, B.e_mul_of_corner hz, if_neg hv, smul_zero]
    · simp
  rw [this]; abel

theorem corner_mul {i j : Fin B.n} {z : A} (hz : B.e i * z * B.e j = z) (a : A) :
    ∃ (c : k) (r : A), r ∈ B.R ∧ z * a = c • z + z * r := by
  obtain ⟨c, hc⟩ := B.decomp a
  refine ⟨c j, a - ∑ v, c v • B.e v, hc, ?_⟩
  rw [mul_sub, Finset.mul_sum]
  have : ∑ v, z * (c v • B.e v) = c j • z := by
    rw [Finset.sum_eq_single j]
    · rw [mul_smul_comm, B.mul_e_of_corner hz, if_pos rfl]
    · intro v _ hv; rw [mul_smul_comm, B.mul_e_of_corner hz, if_neg (Ne.symm hv), smul_zero]
    · simp
  rw [this]; abel

/-- The ideal of a corner element is the element plus radical multiples. -/
theorem Id_le {i j : Fin B.n} {z : A} (hz : B.e i * z * B.e j = z) :
    Id (k := k) z ≤ Submodule.span k {z} ⊔ B.R * Id (k := k) z ⊔ Id (k := k) z * B.R := by
  rw [Id, Submodule.span_le]
  rintro _ ⟨a, b, rfl⟩
  obtain ⟨c, r, hr, hac⟩ := B.mul_corner hz a
  obtain ⟨c', r', hr', hbc⟩ := B.corner_mul hz b
  have e1 : a * z * b = (c * c') • z + c • (z * r') + r * (z * b) := by
    rw [hac, add_mul, smul_mul_assoc, mul_assoc r]
    congr 1
    rw [hbc, smul_add, smul_smul]
  rw [e1]
  refine Submodule.add_mem _ (Submodule.add_mem _ ?_ ?_) ?_
  · exact Submodule.mem_sup_left (Submodule.mem_sup_left
      (Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self z)))
  · exact Submodule.mem_sup_right (Submodule.smul_mem _ _
      (Submodule.mul_mem_mul (mem_Id_self z) hr'))
  · exact Submodule.mem_sup_left (Submodule.mem_sup_right
      (Submodule.mul_mem_mul hr (Id_mul_right z b (mem_Id_self z))))

theorem mul_mem_mul_left {P Q : Submodule k A} (hP : ∀ (a p : A), p ∈ P → a * p ∈ P) :
    ∀ (a x : A), x ∈ P * Q → a * x ∈ P * Q := fun a x hx ↦
  Submodule.mul_induction_on hx
    (fun p hp q hq ↦ by rw [← mul_assoc]; exact Submodule.mul_mem_mul (hP a p hp) hq)
    (fun x y h h' ↦ by rw [mul_add]; exact Submodule.add_mem _ h h')

theorem mul_mem_mul_right {P Q : Submodule k A} (hQ : ∀ (q a : A), q ∈ Q → q * a ∈ Q) :
    ∀ (x a : A), x ∈ P * Q → x * a ∈ P * Q := fun x a hx ↦
  Submodule.mul_induction_on hx
    (fun p hp q hq ↦ by rw [mul_assoc]; exact Submodule.mul_mem_mul hp (hQ q a hq))
    (fun x y h h' ↦ by rw [add_mul]; exact Submodule.add_mem _ h h')

theorem sup_mul_left {P Q : Submodule k A} (hP : ∀ (a p : A), p ∈ P → a * p ∈ P)
    (hQ : ∀ (a p : A), p ∈ Q → a * p ∈ Q) : ∀ (a x : A), x ∈ P ⊔ Q → a * x ∈ P ⊔ Q := by
  intro a x hx
  obtain ⟨p, hp, q, hq, rfl⟩ := Submodule.mem_sup.mp hx
  rw [mul_add]; exact Submodule.add_mem_sup (hP a p hp) (hQ a q hq)

theorem sup_mul_right {P Q : Submodule k A} (hP : ∀ (p a : A), p ∈ P → p * a ∈ P)
    (hQ : ∀ (p a : A), p ∈ Q → p * a ∈ Q) : ∀ (x a : A), x ∈ P ⊔ Q → x * a ∈ P ⊔ Q := by
  intro x a hx
  obtain ⟨p, hp, q, hq, rfl⟩ := Submodule.mem_sup.mp hx
  rw [add_mul]; exact Submodule.add_mem_sup (hP p a hp) (hQ q a hq)

/-- `R(z) + (z)R + R(z') + (z')R`. -/
def B0 (z z' : A) : Submodule k A :=
  B.R * Id (k := k) z ⊔ Id (k := k) z * B.R ⊔ B.R * Id (k := k) z' ⊔ Id (k := k) z' * B.R

theorem B0_left (z z' a : A) {x : A} (hx : x ∈ B.B0 z z') : a * x ∈ B.B0 z z' := by
  have hR : ∀ (a p : A), p ∈ B.R → a * p ∈ B.R := B.mul_mem_left
  have hI : ∀ (w a p : A), p ∈ Id (k := k) w → a * p ∈ Id (k := k) w :=
    fun w a p hp ↦ Id_mul_left w a hp
  exact sup_mul_left (sup_mul_left (sup_mul_left (mul_mem_mul_left hR)
    (mul_mem_mul_left (hI z))) (mul_mem_mul_left hR)) (mul_mem_mul_left (hI z')) a x hx

theorem B0_right (z z' a : A) {x : A} (hx : x ∈ B.B0 z z') : x * a ∈ B.B0 z z' := by
  have hR : ∀ (p a : A), p ∈ B.R → p * a ∈ B.R := B.mul_mem_right
  have hI : ∀ (w p a : A), p ∈ Id (k := k) w → p * a ∈ Id (k := k) w :=
    fun w p a hp ↦ Id_mul_right w a hp
  exact sup_mul_right (sup_mul_right (sup_mul_right (mul_mem_mul_right (hI z))
    (mul_mem_mul_right hR)) (mul_mem_mul_right (hI z'))) (mul_mem_mul_right hR) x a hx

theorem B0_le_R (z z' : A) : B.B0 z z' ≤ B.R := by
  have h1 : ∀ X : Submodule k A, B.R * X ≤ B.R := fun X ↦ Submodule.mul_le.mpr
    fun r hr x _ ↦ B.mul_mem_right r x hr
  have h2 : ∀ X : Submodule k A, X * B.R ≤ B.R := fun X ↦ Submodule.mul_le.mpr
    fun x _ r hr ↦ B.mul_mem_left x r hr
  exact sup_le (sup_le (sup_le (h1 _) (h2 _)) (h1 _)) (h2 _)

theorem rmul_mem_B0 (z z' : A) {r : A} (hr : r ∈ B.R) :
    r * z ∈ B.B0 z z' ∧ z * r ∈ B.B0 z z' ∧ r * z' ∈ B.B0 z z' ∧ z' * r ∈ B.B0 z z' := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · exact Submodule.mem_sup_left (Submodule.mem_sup_left (Submodule.mem_sup_left
      (Submodule.mul_mem_mul hr (mem_Id_self z))))
  · exact Submodule.mem_sup_left (Submodule.mem_sup_left (Submodule.mem_sup_right
      (Submodule.mul_mem_mul (mem_Id_self z) hr)))
  · exact Submodule.mem_sup_left (Submodule.mem_sup_right
      (Submodule.mul_mem_mul hr (mem_Id_self z')))
  · exact Submodule.mem_sup_right (Submodule.mul_mem_mul (mem_Id_self z') hr)

/-- If `z ∈ (z') + B₀` then `z ∈ (z')`. -/
theorem mem_Id_of_mem_sup {i j : Fin B.n} {z z' : A} (hz : B.e i * z * B.e j = z)
    (hzR : z ∈ B.R) (h : z ∈ Id (k := k) z' ⊔ B.B0 z z') : z ∈ Id (k := k) z' := by
  set X := Id (k := k) z
  set Y := Id (k := k) z'
  have hY1 : B.R * Y ≤ Y := Submodule.mul_le.mpr fun r _ y hy ↦ Id_mul_left z' r hy
  have hY2 : Y * B.R ≤ Y := Submodule.mul_le.mpr fun y hy r _ ↦ Id_mul_right z' r hy
  have hB : Y ⊔ B.B0 z z' ≤ Y ⊔ B.R * X ⊔ X * B.R := by
    refine sup_le (le_sup_of_le_left le_sup_left) (sup_le (sup_le (sup_le ?_ ?_) ?_) ?_)
    · exact le_sup_of_le_left le_sup_right
    · exact le_sup_right
    · exact le_sup_of_le_left (le_sup_of_le_left hY1)
    · exact le_sup_of_le_left (le_sup_of_le_left hY2)
  have hle : X ≤ Y ⊔ B.R * X ⊔ X * B.R := by
    refine (B.Id_le hz).trans (sup_le (sup_le ?_ (le_sup_of_le_left le_sup_right)) le_sup_right)
    rw [Submodule.span_le, Set.singleton_subset_iff]
    exact hB h
  exact B.le_of_le_sup (B.Id_le_R hzR) hY1 hY2 hle (mem_Id_self z)

section Family

variable {i j : Fin B.n} {z z' : A}

/-- The left ideal `I = (w) + B₀`. -/
def Lid (w z z' : A) : Submodule A A where
  carrier := ((Id (k := k) w ⊔ B.B0 z z' : Submodule k A) : Set A)
  add_mem' := fun ha hb ↦ Submodule.add_mem (Id (k := k) w ⊔ B.B0 z z') ha hb
  zero_mem' := Submodule.zero_mem (Id (k := k) w ⊔ B.B0 z z')
  smul_mem' := fun a x hx ↦ sup_mul_left (fun a p hp ↦ Id_mul_left w a hp)
    (fun a p hp ↦ B.B0_left z z' a hp) a x hx

theorem mem_Lid {w z z' x : A} : x ∈ B.Lid w z z' ↔ x ∈ Id (k := k) w ⊔ B.B0 z z' := Iff.rfl

/-- The ambient module `A/I₁ × A/I₂`. -/
abbrev Mod (z z' : A) := (A ⧸ B.Lid z z z') × (A ⧸ B.Lid z' z z')

/-- The generator `t = (ē_j, ē_j)`. -/
def tt (j : Fin B.n) (z z' : A) : B.Mod z z' :=
  (Submodule.Quotient.mk (B.e j), Submodule.Quotient.mk (B.e j))

theorem smul_tt (a : A) : a • B.tt j z z' =
    (Submodule.Quotient.mk (a * B.e j), Submodule.Quotient.mk (a * B.e j)) := by
  simp [tt, ← Submodule.Quotient.mk_smul]

theorem kill {x : A} (hx : x ∈ B.B0 z z') : x • B.tt j z z' = 0 := by
  rw [smul_tt]
  have h := B.B0_right z z' (B.e j) hx
  ext
  · exact (Submodule.Quotient.mk_eq_zero _).mpr (Submodule.mem_sup_right h)
  · exact (Submodule.Quotient.mk_eq_zero _).mpr (Submodule.mem_sup_right h)

theorem B0_comm (z z' : A) : B.B0 z z' = B.B0 z' z := by
  simp only [B0]; ac_rfl

theorem tt_ej : B.e j • B.tt j z z' = B.tt j z z' := by rw [smul_tt, B.e_idem]; rfl

theorem z_tt (hz : B.e i * z * B.e j = z) :
    z • B.tt j z z' = (0, Submodule.Quotient.mk z) := by
  have hze : z * B.e j = z := by rw [← hz, mul_assoc, B.e_idem]
  rw [smul_tt, hze]
  ext
  · exact (Submodule.Quotient.mk_eq_zero _).mpr (Submodule.mem_sup_left (mem_Id_self z))
  · rfl

theorem z'_tt (hz' : B.e i * z' * B.e j = z') :
    z' • B.tt j z z' = (Submodule.Quotient.mk z', 0) := by
  have hze : z' * B.e j = z' := by rw [← hz', mul_assoc, B.e_idem]
  rw [smul_tt, hze]
  ext
  · rfl
  · exact (Submodule.Quotient.mk_eq_zero _).mpr (Submodule.mem_sup_left (mem_Id_self z'))

/-- The relation vector `(z' - c z) t`. -/
def ww (j : Fin B.n) (z z' : A) (c : k) : B.Mod z z' := (z' - c • z) • B.tt j z z'

theorem ww_eq (c : k) : B.ww j z z' c = z' • B.tt j z z' - c • (z • B.tt j z z') := by
  rw [ww, sub_smul, smul_assoc]

theorem smul_ww (hz : B.e i * z * B.e j = z) (hz' : B.e i * z' * B.e j = z') (c : k) (a : A) :
    ∃ μ : k, a • B.ww j z z' c = μ • B.ww j z z' c := by
  have hy : B.e i * (z' - c • z) * B.e j = z' - c • z := by
    rw [mul_sub, sub_mul, mul_smul_comm, smul_mul_assoc, hz, hz']
  obtain ⟨μ, r, hr, hμ⟩ := B.mul_corner hy a
  refine ⟨μ, ?_⟩
  obtain ⟨h1, -, h3, -⟩ := B.rmul_mem_B0 z z' hr
  have hB : r * (z' - c • z) ∈ B.B0 z z' := by
    rw [mul_sub, mul_smul_comm]
    exact Submodule.sub_mem _ h3 (Submodule.smul_mem _ c h1)
  rw [ww, ← mul_smul, hμ, add_smul, B.kill hB, add_zero, smul_assoc]

/-- The cyclic submodule generated by the relation vector. -/
def NN (j : Fin B.n) (z z' : A) (c : k) : Submodule A (B.Mod z z') :=
  Submodule.span A {B.ww j z z' c}

theorem mem_NN (hz : B.e i * z * B.e j = z) (hz' : B.e i * z' * B.e j = z') (c : k)
    {x : B.Mod z z'} : x ∈ B.NN j z z' c ↔ ∃ μ : k, x = μ • B.ww j z z' c := by
  constructor
  · intro hx
    obtain ⟨a, rfl⟩ := Submodule.mem_span_singleton.mp hx
    obtain ⟨μ, hμ⟩ := B.smul_ww hz hz' c a
    exact ⟨μ, hμ⟩
  · rintro ⟨μ, rfl⟩
    exact Submodule.mem_span_singleton.mpr ⟨algebraMap k A μ, algebraMap_smul A μ _⟩

end Family

section Family2

variable {i j : Fin B.n} {z z' : A} (hz : B.e i * z * B.e j = z) (hz' : B.e i * z' * B.e j = z')
  (hzR : z ∈ B.R) (hz'R : z' ∈ B.R)
  (h1 : z ∉ Id (k := k) z') (h2 : z' ∉ Id (k := k) z)

include hz hzR h1 in
theorem mk_z_ne : (Submodule.Quotient.mk z : A ⧸ B.Lid z' z z') ≠ 0 := by
  intro h
  rw [Submodule.Quotient.mk_eq_zero] at h
  exact h1 (B.mem_Id_of_mem_sup hz hzR h)

include hz' hz'R h2 in
theorem mk_z'_ne : (Submodule.Quotient.mk z' : A ⧸ B.Lid z z z') ≠ 0 := by
  intro h
  rw [Submodule.Quotient.mk_eq_zero] at h
  refine h2 (B.mem_Id_of_mem_sup hz' hz'R ?_)
  have h' : z' ∈ Id (k := k) z ⊔ B.B0 z z' := h
  rwa [B.B0_comm] at h'

include hz hz' hzR hz'R h1 h2 in
theorem z_tt_notin (d : k) : z • B.tt j z z' ∉ B.NN j z z' d := by
  intro h
  obtain ⟨μ, hμ⟩ := (B.mem_NN hz hz' d).mp h
  rw [ww_eq, B.z_tt hz, B.z'_tt hz'] at hμ
  have e1 := congrArg Prod.fst hμ
  have e2 := congrArg Prod.snd hμ
  simp only [Prod.smul_fst, Prod.fst_sub, Prod.smul_snd, Prod.snd_sub, smul_zero, sub_zero,
    zero_sub] at e1 e2
  rcases smul_eq_zero.mp e1.symm with hμ0 | hz0
  · rw [hμ0, zero_smul] at e2
    exact B.mk_z_ne hz hzR h1 e2
  · exact B.mk_z'_ne hz' hz'R h2 hz0

include hz hz' hzR hz'R in
theorem tt_notin (d : k) : B.tt j z z' ∉ B.NN j z z' d := by
  intro h
  obtain ⟨μ, hμ⟩ := (B.mem_NN hz hz' d).mp h
  rw [ww_eq, B.z_tt hz, B.z'_tt hz'] at hμ
  have e1 := congrArg Prod.fst hμ
  simp only [tt, Prod.smul_fst, Prod.fst_sub, smul_zero, sub_zero] at e1
  rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.eq] at e1
  have hle : Id (k := k) z ⊔ B.B0 z z' ≤ B.R := sup_le (B.Id_le_R hzR) (B.B0_le_R z z')
  have hm : B.e j - μ • z' ∈ B.R := hle e1
  apply B.e_not_mem j
  have := B.R.add_mem hm (B.R.smul_mem μ hz'R)
  rwa [sub_add_cancel] at this

/-- The annihilator-type left ideal of the generator in `V_c`. -/
def KK (j : Fin B.n) (z z' : A) (c : k) : Submodule A A :=
  (B.NN j z z' c).comap (LinearMap.toSpanSingleton A (B.Mod z z') (B.tt j z z'))

theorem mem_KK {c : k} {x : A} : x ∈ B.KK j z z' c ↔ x • B.tt j z z' ∈ B.NN j z z' c := Iff.rfl

/-- **Jans' module** `V_c`. -/
abbrev VV (j : Fin B.n) (z z' : A) (c : k) := A ⧸ B.KK j z z' c

/-- The generator of `V_c`. -/
def vv (j : Fin B.n) (z z' : A) (c : k) : B.VV j z z' c := Submodule.Quotient.mk 1

theorem mk_eq_smul_vv (c : k) (a : A) :
    (Submodule.Quotient.mk a : B.VV j z z' c) = a • B.vv j z z' c := by
  rw [vv, ← Submodule.Quotient.mk_smul, smul_eq_mul, mul_one]

theorem vv_gen (c : k) : Submodule.span A {B.vv j z z' c} = ⊤ := by
  rw [eq_top_iff]
  intro x _
  obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective _ x
  rw [B.mk_eq_smul_vv]
  exact Submodule.smul_mem _ a (Submodule.mem_span_singleton_self _)

theorem vv_ej (c : k) : B.e j • B.vv j z z' c = B.vv j z z' c := by
  rw [← B.mk_eq_smul_vv, vv, Submodule.Quotient.eq, mem_KK, sub_smul, one_smul, B.tt_ej,
    sub_self]
  exact Submodule.zero_mem _

include hz hz' hzR hz'R in
theorem vv_ne (c : k) : B.vv j z z' c ≠ 0 := by
  rw [vv, Ne, Submodule.Quotient.mk_eq_zero, mem_KK, one_smul]
  exact B.tt_notin hz hz' hzR hz'R c

theorem vv_rel (c : k) : (z' - c • z) • B.vv j z z' c = 0 := by
  rw [← B.mk_eq_smul_vv, Submodule.Quotient.mk_eq_zero, mem_KK]
  exact Submodule.mem_span_singleton_self _

theorem vv_fd (c : k) [FiniteDimensional k A] : FiniteDimensional k (B.VV j z z' c) := by
  have : Module.Finite A (B.VV j z z' c) :=
    Module.Finite.of_surjective (B.KK j z z' c).mkQ (Submodule.mkQ_surjective _)
  exact Module.Finite.trans A _

include hz hz' hzR hz'R in
theorem vv_indec [FiniteDimensional k A] (c : k) :
    Statement.IsIndecomposable A (B.VV j z z' c) := by
  have : Nontrivial (B.VV j z z' c) := ⟨⟨_, _, B.vv_ne hz hz' hzR hz'R c⟩⟩
  have := B.vv_fd (j := j) (z := z) (z' := z') c
  exact B.isIndecomposable_of_gen (B.vv_gen c) (B.vv_ej c)

include hz hz' hzR hz'R h1 h2 in
/-- **Jans' modules are pairwise non-isomorphic.** -/
theorem eq_of_equiv {c d : k} (φ : B.VV j z z' c ≃ₗ[A] B.VV j z z' d) : c = d := by
  have hφ : φ (B.vv j z z' c) ∈ Submodule.span A {B.vv j z z' d} := by
    rw [B.vv_gen]; trivial
  obtain ⟨a0, ha0⟩ := Submodule.mem_span_singleton.mp hφ
  obtain ⟨μ, r, hr, -, hc⟩ := B.corner j a0
  have hφv : φ (B.vv j z z' c) = (algebraMap k A μ + r) • B.vv j z z' d := by
    have h1' : φ (B.vv j z z' c) = (B.e j * a0 * B.e j) • B.vv j z z' d := by
      rw [mul_smul, mul_smul, B.vv_ej, ha0, ← map_smul, B.vv_ej]
    rw [h1', hc, add_smul, smul_assoc, B.vv_ej, add_smul, algebraMap_smul]
  -- the relation transported to `V_d`
  have hrel : ((z' - c • z) * (algebraMap k A μ + r)) • B.tt j z z' ∈ B.NN j z z' d := by
    rw [← mem_KK, ← Submodule.Quotient.mk_eq_zero, B.mk_eq_smul_vv, mul_smul, ← hφv,
      ← map_smul, B.vv_rel, map_zero]
  obtain ⟨h1z, -, h3z, -⟩ := B.rmul_mem_B0 z z' hr
  have hB : (z' - c • z) * r ∈ B.B0 z z' := by
    obtain ⟨-, a2, -, a4⟩ := B.rmul_mem_B0 z z' hr
    rw [sub_mul, smul_mul_assoc]
    exact Submodule.sub_mem _ a4 (Submodule.smul_mem _ c a2)
  rw [mul_add, add_smul, B.kill hB, add_zero, ← Algebra.commutes, mul_smul, algebraMap_smul]
    at hrel
  have hwc : (z' - c • z) • B.tt j z z' = B.ww j z z' c := rfl
  rw [hwc] at hrel
  have hwd : B.ww j z z' d ∈ B.NN j z z' d := Submodule.mem_span_singleton_self _
  have hdiff : (μ * (d - c)) • (z • B.tt j z z') ∈ B.NN j z z' d := by
    have := Submodule.sub_mem _ hrel (Submodule.smul_mem _ (algebraMap k A μ) hwd)
    rw [algebraMap_smul, ← smul_sub, ww_eq, ww_eq] at this
    convert this using 1
    rw [mul_smul, sub_smul]
    congr 1
    abel
  by_contra hcd
  by_cases hμ : μ = 0
  · subst hμ
    rw [map_zero, zero_add] at hφv
    obtain ⟨x, hx⟩ := φ.surjective (B.vv j z z' d)
    have hx' : x ∈ Submodule.span A {B.vv j z z' c} := by rw [B.vv_gen]; trivial
    obtain ⟨b, rfl⟩ := Submodule.mem_span_singleton.mp hx'
    rw [map_smul, hφv, smul_smul] at hx
    exact B.vv_ne hz hz' hzR hz'R d (B.smul_eq_zero_of_eq (B.mul_mem_left b r hr) hx.symm)
  · have hne : μ * (d - c) ≠ 0 := mul_ne_zero hμ (sub_ne_zero.mpr (Ne.symm hcd))
    apply B.z_tt_notin hz hz' hzR hz'R h1 h2 d
    have := Submodule.smul_mem _ (algebraMap k A (μ * (d - c))⁻¹) hdiff
    rwa [algebraMap_smul, smul_smul, inv_mul_cancel₀ hne, one_smul] at this

end Family2

/-- **Jans' theorem** (in the form needed): over a representation-finite algebra, for
`z, z' ∈ e_iAe_j` one lies in the two-sided ideal generated by the other. -/
theorem mem_Id_or_mem_Id [FiniteDimensional k A] [Infinite k] (hrf : IsRepFinite A)
    {i j : Fin B.n} {z z' : A} (hz : B.e i * z * B.e j = z) (hz' : B.e i * z' * B.e j = z') :
    z ∈ Id (k := k) z' ∨ z' ∈ Id (k := k) z := by
  by_contra h
  push Not at h
  obtain ⟨h1, h2⟩ := h
  have hR : ∀ {w w' : A}, B.e i * w * B.e j = w → B.e i * w' * B.e j = w' →
      w' ∉ Id (k := k) w → w ∈ B.R := by
    intro w w' hw hw' hn
    by_cases hij : i = j
    · subst hij
      obtain ⟨c, r, hr, hre, hc⟩ := B.corner i w
      rw [hw] at hc
      by_cases hc0 : c = 0
      · rw [hc, hc0, zero_smul, zero_add]; exact hr
      · exfalso
        apply hn
        obtain ⟨u, hu⟩ := B.isUnit_add hc0 hr
        have hre' : r * B.e i = r := by rw [← hre, mul_assoc, B.e_idem]
        have hwu : w = (algebraMap k A c + r) * B.e i := by
          rw [add_mul, hre', ← Algebra.smul_def, hc]
        have hei : B.e i ∈ Id (k := k) w := by
          have : B.e i = (↑u⁻¹ : A) * w * 1 := by
            rw [mul_one, hwu, ← hu, ← mul_assoc, Units.inv_mul, one_mul]
          rw [this]
          exact Submodule.subset_span ⟨_, _, rfl⟩
        rw [← hw']
        exact Id_mul_right w _ (Id_mul_right w w' hei)
    · rw [← hw]; exact B.corner_mem hij w
  have hzR := hR hz hz' h2
  have hz'R := hR hz' hz h1
  obtain ⟨n, Bs, hB⟩ := hrf
  have hfin : ∀ c : k, Module.Finite A (B.VV j z z' c) := fun c ↦
    Module.Finite.of_surjective (B.KK j z z' c).mkQ (Submodule.mkQ_surjective _)
  have hidx : ∀ c : k, ∃ m, Nonempty (B.VV j z z' c ≃ₗ[A] Bs m) := fun c ↦
    hB _ (B.vv_indec hz hz' hzR hz'R c)
  choose idx hidx using hidx
  obtain ⟨c, d, hcd, he⟩ := Finite.exists_ne_map_eq_of_infinite idx
  obtain ⟨ec⟩ := hidx c
  obtain ⟨ed⟩ := hidx d
  rw [he] at ec
  exact hcd (B.eq_of_equiv hz hz' hzR hz'R h1 h2 (ec.trans ed.symm))



