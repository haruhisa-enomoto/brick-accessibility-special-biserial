module

public import BrickAccessibility.SkowWasch.Basic
public import BrickAccessibility.Statement
public import Mathlib.LinearAlgebra.Projection
public import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas

/-!
# Local cyclic modules

A module generated by an element `v = e_j v` has only bijective or nilpotent
endomorphisms, hence is indecomposable (`isIndecomposable_of_gen`).
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace BrickAccessibility

namespace SkowWasch

namespace BasicData

universe u

variable {k : Type*} [Field k] {A : Type u} [Ring A] [Algebra k A] (B : BasicData k A)

theorem smul_eq_zero_of_eq {V : Type*} [AddCommGroup V] [Module A V] {s : A} (hs : s ∈ B.R)
    {x : V} (h : x = s • x) : x = 0 := by
  obtain ⟨u, hu⟩ := B.isUnit_one_sub hs
  have h1 : (1 - s) • x = 0 := by rw [sub_smul, one_smul, ← h, sub_self]
  rw [← hu] at h1
  have := congrArg (fun y ↦ (↑u⁻¹ : A) • y) h1
  simpa [smul_smul] using this

variable {V : Type u} [AddCommGroup V] [Module A V] [Module k V] [IsScalarTower k A V]
  [FiniteDimensional k V]

/-- A generator fixed by `e_j` sees every endomorphism as a scalar plus a radical element. -/
theorem endo_gen {j : Fin B.n} {v : V} (hgen : Submodule.span A {v} = ⊤) (hv : B.e j • v = v)
    (f : V →ₗ[A] V) : ∃ (c : k) (r : A), r ∈ B.R ∧ f v = (algebraMap k A c + r) • v := by
  have hfv : f v ∈ Submodule.span A {v} := by rw [hgen]; trivial
  obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp hfv
  obtain ⟨c, r, hr, -, hc⟩ := B.corner j a
  refine ⟨c, r, hr, ?_⟩
  have h1 : f v = (B.e j * a * B.e j) • v := by
    rw [mul_smul, mul_smul, hv, ha, ← map_smul, hv]
  rw [h1, hc, add_smul, smul_assoc, hv, add_smul, algebraMap_smul]

theorem endo_dichotomy {j : Fin B.n} {v : V} (hgen : Submodule.span A {v} = ⊤)
    (hv : B.e j • v = v) (f : V →ₗ[A] V) :
    Function.Bijective f ∨ ∃ N : ℕ, f ^ N = 0 := by
  obtain ⟨c, r, hr, hf⟩ := B.endo_gen hgen hv f
  by_cases hc : c = 0
  · right
    subst hc
    rw [map_zero, zero_add] at hf
    have hpow : ∀ m : ℕ, (f ^ m) v = r ^ m • v := by
      intro m
      induction m with
      | zero => simp
      | succ m ih => rw [pow_succ', Module.End.mul_apply, ih, map_smul, hf, smul_smul, ← pow_succ]
    obtain ⟨N, hN⟩ := B.isNilpotent hr
    refine ⟨N, ?_⟩
    have hker : v ∈ LinearMap.ker (f ^ N) := by
      rw [LinearMap.mem_ker, hpow, hN, zero_smul]
    have : LinearMap.ker (f ^ N) = ⊤ := by
      rw [eq_top_iff, ← hgen, Submodule.span_le, Set.singleton_subset_iff]; exact hker
    exact LinearMap.ker_eq_top.mp this
  · left
    obtain ⟨u, hu⟩ := B.isUnit_add hc hr
    have hsurj : Function.Surjective f := by
      have hv' : v ∈ LinearMap.range f := ⟨(↑u⁻¹ : A) • v, by
        rw [map_smul, hf, ← hu, smul_smul, Units.inv_mul, one_smul]⟩
      have : LinearMap.range f = ⊤ := by
        rw [eq_top_iff, ← hgen, Submodule.span_le, Set.singleton_subset_iff]; exact hv'
      exact LinearMap.range_eq_top.mp this
    have hinj : Function.Injective f :=
      LinearMap.injective_iff_surjective (f := f.restrictScalars k) |>.mpr hsurj
    exact ⟨hinj, hsurj⟩

/-- **A module generated by `v = e_j v` is indecomposable.** -/
theorem isIndecomposable_of_gen [Nontrivial V] {j : Fin B.n} {v : V}
    (hgen : Submodule.span A {v} = ⊤) (hv : B.e j • v = v) :
    Statement.IsIndecomposable A V := by
  refine ⟨inferInstance, fun X Y hXY ↦ ?_⟩
  set p : V →ₗ[A] V := X.subtype ∘ₗ Submodule.projectionOnto X Y hXY
  have hX : ∀ x ∈ X, p x = x := fun x hx ↦ by
    show X.subtype (Submodule.projectionOnto X Y hXY ((⟨x, hx⟩ : X) : V)) = x
    rw [Submodule.projectionOnto_apply_left]; rfl
  have hY : ∀ y ∈ Y, p y = 0 := fun y hy ↦ by
    show X.subtype (Submodule.projectionOnto X Y hXY ((⟨y, hy⟩ : Y) : V)) = 0
    rw [Submodule.projectionOnto_apply_right]; rfl
  have hpp : ∀ w, p (p w) = p w := fun w ↦ hX _ (by simp [p])
  rcases B.endo_dichotomy hgen hv p with hb | ⟨N, hN⟩
  · right
    rw [eq_bot_iff]
    intro y hy
    have h1 : p (p y) = p y := hpp y
    have h2 : p y = y := hb.1 h1
    rw [Submodule.mem_bot, ← h2, hY y hy]
  · left
    have hpow : ∀ m : ℕ, p ^ (m + 1) = p := by
      intro m
      induction m with
      | zero => simp
      | succ m ih =>
          rw [pow_succ, ih]; ext w; exact hpp w
    have hp0 : p = 0 := by
      rcases N with _ | N
      · rw [pow_zero] at hN
        ext w
        have := LinearMap.congr_fun hN w
        simp only [Module.End.one_apply, LinearMap.zero_apply] at this
        simp [this]
      · rw [← hpow N, hN]
    rw [eq_bot_iff]
    intro x hx
    rw [Submodule.mem_bot, ← hX x hx, hp0, LinearMap.zero_apply]

end BasicData

end SkowWasch

end BrickAccessibility
